<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DisplayMaster.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Design tokens shared with the Android app (ui/theme/Theme.kt). -->
            <Color x:Key="BrandAccentColor">#FF3B6BFF</Color>
            <Color x:Key="BrandConnectedColor">#FF00BFA5</Color>
            <Color x:Key="BrandPenColor">#FFFF7A59</Color>
            <SolidColorBrush x:Key="ConnectedBrush" Color="{StaticResource BrandConnectedColor}" />
            <SolidColorBrush x:Key="PenBrush" Color="{StaticResource BrandPenColor}" />
            <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{StaticResource BrandAccentColor}" />
                <GradientStop Offset="1" Color="{StaticResource BrandConnectedColor}" />
            </LinearGradientBrush>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="24" />
            </Style>

            <Style x:Key="PillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,4" />
            </Style>

            <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}" />

            <Style x:Key="StatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
