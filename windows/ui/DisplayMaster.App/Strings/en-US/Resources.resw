  <data name="SettingsPage_8.Text" xml:space="preserve">
    <value>Bitrate</value>
  </data>
  <data name="SettingsPage_9.Text" xml:space="preserve">
    <value>Higher is sharper, especially for text and fast motion. Over Wi-Fi, 20-40 Mbit/s is usually the sweet spot.</value>
  </data>
  <data name="SettingsPage_10.Text" xml:space="preserve">
    <value>Frame rate</value>
  </data>
