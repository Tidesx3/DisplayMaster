  <data name="SettingsPage_5.Text" xml:space="preserve">
    <value>Quality</value>
  </data>
  <data name="SettingsPage_6.Text" xml:space="preserve">
    <value>Automatic picks the bitrate from resolution, frame rate and connection (more over USB than Wi-Fi).</value>
