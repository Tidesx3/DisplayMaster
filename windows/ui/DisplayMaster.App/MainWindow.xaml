<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DisplayMaster.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DisplayMaster">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: logo + name, content extends under it. -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="20" Height="20" VerticalAlignment="Center" Source="ms-appx:///Assets/Logo.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="DisplayMaster" />
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Devices" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Pen &amp; Touch" Tag="pen">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDC6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Connection" Tag="connection">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE839;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- New release on GitHub: one click downloads, verifies and installs it. -->
                <InfoBar
                    MaxWidth="960"
                    Margin="40,16,40,0"
                    IsClosable="False"
                    IsOpen="{x:Bind Update.IsAvailable, Mode=OneWay}"
                    Message="{x:Bind Update.Message, Mode=OneWay}"
                    Severity="Informational"
                    Title="Update available">
                    <InfoBar.Content>
                        <StackPanel Margin="0,0,0,14" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind Update.InstallCommand}" Content="Update now" Style="{StaticResource AccentButtonStyle}" />
                                <HyperlinkButton Click="ReleaseNotes_Click" Content="What's new" />
                                <Button Command="{x:Bind Update.DismissCommand}" Content="Later" />
                                <ProgressBar Width="160" VerticalAlignment="Center" Value="{x:Bind Update.Progress, Mode=OneWay}"
                                             Visibility="{x:Bind Update.IsBusy, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind Update.Error, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
