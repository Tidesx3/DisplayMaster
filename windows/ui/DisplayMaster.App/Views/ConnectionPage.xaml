<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DisplayMaster.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DisplayMaster.Views"
    xmlns:services="using:DisplayMaster.Services">

    <ScrollViewer>
        <StackPanel MaxWidth="1040" Padding="40,28,40,40" Spacing="16">
            <TextBlock x:Uid="ConnectionPage_1" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- USB -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xECF0;" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock x:Uid="ConnectionPage_2" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="ConnectionPage_3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                            <Run x:Uid="ConnectionPage_4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Run Text="{x:Bind ViewModel.UsbDevicesText, Mode=OneWay}" />
                        </TextBlock>
                        <InfoBar x:Uid="ConnectionPage_5"
                            IsClosable="False"
                            IsOpen="{x:Bind local:Bind.Not(ViewModel.AdbAvailable), Mode=OneWay}"
                            Severity="Warning" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Wi-Fi -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE701;" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock x:Uid="ConnectionPage_6" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="ConnectionPage_7" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,6,0,0" Spacing="4" Visibility="{x:Bind ViewModel.WifiEnabled, Mode=OneWay}">
                            <TextBlock x:Uid="ConnectionPage_8" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="16" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.AddressesText, Mode=OneWay}" />
                            <!-- No cable needed to get the Android app: the phone downloads it from this PC. -->
                            <Grid Margin="0,10,0,0" ColumnSpacing="16" Visibility="{x:Bind ViewModel.HasApkUrl, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- QR codes need a light background to scan, also in dark mode. -->
                                <Border Padding="6" Background="White" CornerRadius="8">
                                    <Image Width="132" Height="132" Source="{x:Bind local:Bind.QrCode(ViewModel.ApkUrl), Mode=OneWay}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Uid="ConnectionPage_9" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="ConnectionPage_10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Spacing="6" Visibility="{x:Bind ViewModel.HasTrustedDevices, Mode=OneWay}">
                            <TextBlock x:Uid="ConnectionPage_11" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.TrustedDevices}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="services:TrustedDevice">
                                        <Grid Padding="12,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE70A;" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Name}" />
                                            <Button x:Uid="ConnectionPage_12" Grid.Column="2" Click="Forget_Click" Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                    <ToggleSwitch x:Uid="ConnectionPage_13"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        IsOn="{x:Bind ViewModel.WifiEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Engine -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE7F8;" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock x:Uid="ConnectionPage_14" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                            <Run x:Uid="ConnectionPage_15" />
                            <Run Text="{x:Bind local:ConnectionPage.YesNo(ViewModel.VddInstalled, 'installed', 'not installed'), Mode=OneWay}" />
                            <LineBreak />
                            <Run x:Uid="ConnectionPage_16" />
                            <Run Text="{x:Bind local:ConnectionPage.YesNo(ViewModel.Elevated, 'yes', 'no'), Mode=OneWay}" />
                            <LineBreak />
                            <Run x:Uid="ConnectionPage_17" />
                            <Run Text="{x:Bind ViewModel.Port, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button x:Uid="ConnectionPage_18"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.RestartAsAdminCommand}"
                        Visibility="{x:Bind local:Bind.CollapsedIf(ViewModel.Elevated), Mode=OneWay}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
