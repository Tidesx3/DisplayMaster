<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DisplayMaster.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DisplayMaster.Views">

    <ScrollViewer>
        <StackPanel MaxWidth="1040" Padding="40,28,40,40" Spacing="16">
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Picture settings apply to every device right away." />
            </StackPanel>

            <!-- Picture -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE7F4;" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Picture" />
                    </StackPanel>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind Settings.Locked, Mode=OneWay}"
                        Message="The engine was started with picture options on its command line; those are used instead."
                        Severity="Informational" />

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Quality" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Automatic picks the bitrate from resolution, frame rate and connection (more over USB than Wi-Fi)." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsEnabled="{x:Bind Settings.CanEdit, Mode=OneWay}" IsOn="{x:Bind Settings.AutoBitrate, Mode=TwoWay}"
                                      OffContent="Fixed" OnContent="Automatic" />
                    </Grid>
                    <StackPanel Spacing="2" Visibility="{x:Bind local:Bind.CollapsedIf(Settings.AutoBitrate), Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="Bitrate" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Settings.BitrateText, Mode=OneWay}" />
                        </Grid>
                        <Slider IsEnabled="{x:Bind Settings.CanEdit, Mode=OneWay}" Maximum="150" Minimum="5" StepFrequency="5" Value="{x:Bind Settings.BitrateMbps, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                   Text="Higher is sharper, especially for text and fast motion. Over Wi-Fi, 20-40 Mbit/s is usually the sweet spot." />
                    </StackPanel>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Frame rate" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Never more than the device's screen can show." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="{x:Bind Settings.CanEdit, Mode=OneWay}"
                                  ItemsSource="{x:Bind Settings.FrameRates}" SelectedItem="{x:Bind Settings.FrameRate, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Resolution" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Size of the extended screen compared with the device's display." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="{x:Bind Settings.CanEdit, Mode=OneWay}"
                                  ItemsSource="{x:Bind Settings.Scales}" SelectedItem="{x:Bind Settings.Scale, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Video format" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Used when both the PC and the device support it; otherwise the next best one." />
                        </StackPanel>
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="{x:Bind Settings.CanEdit, Mode=OneWay}"
                                  ItemsSource="{x:Bind Settings.Codecs}" SelectedItem="{x:Bind Settings.Codec, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Startup -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE7E8;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Start when I sign in" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="DisplayMaster waits in the notification area so devices can connect right away. Off: it only runs while you have it open." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsOn="{x:Bind Settings.StartWithWindows, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Notifications -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xEA8F;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Connection notifications" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="A Windows notification when a device connects or disconnects." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsOn="{x:Bind Settings.NotifyDevices, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="40" Height="40" VerticalAlignment="Top" Source="ms-appx:///Assets/Logo.png" />
                    <StackPanel Grid.Column="1" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="DisplayMaster" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Settings.VersionText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind Update.CheckNowCommand}" Content="Check for updates" />
                            <Button Command="{x:Bind Settings.OpenLogFolderCommand}" Content="Open log folder" />
                            <HyperlinkButton Command="{x:Bind Settings.OpenProjectPageCommand}" Content="Project page" />
                        </StackPanel>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Update.CheckResult, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
