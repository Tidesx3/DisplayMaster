<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DisplayMaster.Views.PenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="1040" Padding="40,28,40,40" Spacing="16">
            <StackPanel Spacing="2">
                <TextBlock x:Uid="PenPage_1" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="PenPage_2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="22" Foreground="{StaticResource PenBrush}" Glyph="&#xEDC6;" />
                            <TextBlock x:Uid="PenPage_3" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock x:Uid="PenPage_4" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind Pen.MinPercent, Mode=OneWay}" /><Run Text=" %" />
                                </TextBlock>
                            </Grid>
                            <Slider Maximum="50" Minimum="0" StepFrequency="1" Value="{x:Bind Pen.MinPercent, Mode=TwoWay}" />
                            <TextBlock x:Uid="PenPage_5" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock x:Uid="PenPage_6" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind Pen.MaxPercent, Mode=OneWay}" /><Run Text=" %" />
                                </TextBlock>
                            </Grid>
                            <Slider Maximum="100" Minimum="50" StepFrequency="1" Value="{x:Bind Pen.MaxPercent, Mode=TwoWay}" />
                            <TextBlock x:Uid="PenPage_7" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock x:Uid="PenPage_8" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Pen.FeelText, Mode=OneWay}" />
                            </Grid>
                            <Slider Maximum="100" Minimum="-100" StepFrequency="1" Value="{x:Bind Pen.Feel, Mode=TwoWay}" />
                            <Grid>
                                <TextBlock x:Uid="PenPage_9" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Uid="PenPage_10" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </StackPanel>

                        <Button x:Uid="PenPage_11" Command="{x:Bind Pen.ResetCommand}" />
                    </StackPanel>

                    <!-- Live response curve: pen pressure (x) -> pressure sent to apps (y). -->
                    <StackPanel Grid.Column="1" Spacing="8">
                        <Border Width="236" Height="236" Padding="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                            <Grid Width="220" Height="220">
                                <Line Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" X1="0" X2="220" Y1="110" Y2="110" />
                                <Line Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" X1="110" X2="110" Y1="0" Y2="220" />
                                <Line Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeDashArray="3,3" X1="0" X2="220" Y1="220" Y2="0" />
                                <Polyline x:Name="CurveLine" Stroke="{StaticResource BrandGradientBrush}" StrokeThickness="3" StrokeLineJoin="Round" />
                            </Grid>
                        </Border>
                        <Grid>
                            <TextBlock x:Uid="PenPage_12" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="PenPage_13" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="PenPage_14" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="PenPage_15" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="PenPage_16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="PenPage_17" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
